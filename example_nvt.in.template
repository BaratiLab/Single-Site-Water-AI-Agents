# Prepared example only: provide PLUGIN, START_DATA, MODEL_PARAMS with -var.
# GPL-2.0-or-later research source. Not an equilibration/property certificate.
units real
atom_style atomic
boundary p p p
atom_modify map array sort 0 0
read_data ${START_DATA}
plugin load ${PLUGIN}
pair_style cg/joint
pair_coeff * * ${MODEL_PARAMS}
neighbor 1 bin
neigh_modify every 1 delay 0 check yes
timestep 1
velocity all create 298.15 917833 mom yes rot no dist gaussian
fix integration all nvt temp 298.15 298.15 1000
thermo_style custom step temp pe ke etotal press vol
thermo_modify norm no
thermo 1000
run 10000
